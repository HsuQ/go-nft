syntax = "v1"

info (
	title:   "以太坊服务"
	desc:    "以太坊服务"
	author:  "Hsurich"
	email:   "hsurich@qq.com"
	version: "v1"
)

type (
	CheckEthArrivedReq {
		Address string `json:"address"`
		Amount  int64  `json:"amount"`
	}
	CheckEthArrivedResp {
		Arrived bool   `json:"arrived"`
		Address string `json:"address"`
		Balance int64  `json:"balance"`
	}
	CheckERC20ArrivedReq {
		Address string `json:"address"`
		Amount  string  `json:"amount"`
	}
	CheckERC20ArrivedResp {
		Arrived bool   `json:"arrived"`
		Address string `json:"address"`
		Balance string  `json:"balance"`
	}
	GetTransactionCountReq {
		Address string `json:"address"`
	}
	GetTransactionCountResp {
		Nonce string  `json:"nonce"`
		Address string `json:"address"`
	}
	SendRawTransactionReq {
		RawTx string `json:"rawTx"`
	}
	SendRawTransactionResp {
		TxHash string `json:"txHash"`
	}
)

@server (
	prefix: eth/v1
	group:  eth
)
service nft {
	@doc "checkEthArrived"
	@handler checkEthArrived
	post /recharge/check (CheckEthArrivedReq) returns (CheckEthArrivedResp)

	@doc "checkERC20rrived"
	@handler checkERC20Arrived
	post /erc20/check (CheckERC20ArrivedReq) returns (CheckERC20ArrivedResp)

	@doc "getTransactionCount"
	@handler getTransactionCount
	post /nonce (GetTransactionCountReq) returns (GetTransactionCountResp)	

	@doc "sendRawTransaction"
	@handler sendRawTransaction
	post /send (SendRawTransactionReq) returns (SendRawTransactionResp)
}
